# ===========================================
# MemoryLLM Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Debug mode (set to false in production)
DEBUG=true

# ===========================================
# Database (SQLite - no setup required!)
# ===========================================
# SQLite database file path (relative to server directory)
# Default: sqlite+aiosqlite:///./memoryllm.db
DATABASE_URL=sqlite+aiosqlite:///./memoryllm.db

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# Gemini API
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===========================================
# Notion API (for memory features)
# ===========================================
# 1. Go to https://www.notion.so/my-integrations
# 2. Create a new integration
# 3. Copy the "Internal Integration Token"
# 4. Share pages/databases with your integration
NOTION_API_KEY=your_notion_integration_token_here

# ===========================================
# CORS (frontend URL)
# ===========================================
# Add your frontend URL here
CORS_ORIGINS=["http://localhost:3000"]

# ===========================================
# File Uploads
# ===========================================
# Directory for uploaded files (relative to server directory)
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ===========================================
# Rate Limiting (defaults shown, no config needed)
# ===========================================
# Rate limits are configured in code:
# - Auth login: 5 requests/minute
# - Auth signup: 3 requests/minute  
# - Chat: 20 requests/minute
# - Conversations: 60 requests/minute
# - Default: 100 requests/minute
