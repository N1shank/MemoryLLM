# REQUIRED - Must be set before starting server

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Get from: https://www.notion.so/my-integrations
# Create an Internal Integration and copy the token (starts with secret_ or ntn_)
# Then share pages with your integration
# Note: This is a global fallback - users can also set their own key in the app
NOTION_API_KEY=

# OPTIONAL - Has defaults, only change if needed

# Database file path (default: sqlite+aiosqlite:///./memoryllm.db)
# DATABASE_URL=sqlite+aiosqlite:///./memoryllm.db

# Debug mode (default: false)
# DEBUG=true

# Frontend URL for CORS (default: ["http://localhost:3000"])
# CORS_ORIGINS=["http://localhost:3000"]

# Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# File upload directory (default: ./uploads)
# UPLOAD_DIR=./uploads

# Max file size in bytes (default: 10485760 = 10MB)
# MAX_UPLOAD_SIZE=10485760
